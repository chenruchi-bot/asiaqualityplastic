<section id="contact" class="section section-bg-alt">
  <div class="container">
    <h2 class="section-title">ติดต่อเรา</h2>
    <div class="contact-grid">
      <div class="contact-info">
        <h3>บริษัท เอเชียควอลิตี้พลาสติก จำกัด</h3>
        <div class="info-item">
          <div class="icon">
            <svg xmlns="http://www.w0.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
          </div>
          <p>222, 224 ซอยพระรามที่ 2 ซอย 3 ถนนพระราม 2 แขวงบางมด เขตจอมทอง กรุงเทพมหานคร 10150</p>
        </div>
        
        <div class="contact-actions">
          <p class="action-label">ติดต่อและเส้นทาง:</p>
          <div class="buttons">
            <a href="tel:024271295" class="btn btn-primary call-btn">
              <svg xmlns="http://www.w0.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="btn-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.48-4.18-7.076-7.076l1.293-.97c.362-.271.527-.733.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
              02 427 1295
            </a>
            <a href="tel:0618585596" class="btn btn-primary call-btn">
              <svg xmlns="http://www.w0.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="btn-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
              061 858 5596
            </a>
            <a href="https://maps.app.goo.gl/v5iRHbqwxK2NpHHQ9" target="_blank" rel="noopener noreferrer" class="btn btn-primary call-btn direction-btn">
              <svg xmlns="http://www.w0.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="btn-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
              ดูเส้นทางบน Google Maps
            </a>
          </div>
        </div>
      </div>
      
      <div class="contact-map">
        <!-- Google Maps Iframe -->
        <iframe 
          src="https://maps.google.com/maps?q=13.6816041,100.4673898&t=&z=15&ie=UTF8&iwloc=&output=embed" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }

  .contact-info {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contact-info h3 {
    font-size: 1.8rem;
    color: var(--color-primary);
    margin-bottom: 2rem;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .info-item .icon {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .info-item p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .contact-actions {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px solid var(--color-accent-light);
  }

  .action-label {
    font-weight: 600;
    color: var(--color-text-light);
    margin-bottom: 1rem;
  }

  .buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .call-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 1.2rem;
    padding: 1rem;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }
  
  .call-btn:hover {
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  }

  .btn-icon {
    width: 24px;
    height: 24px;
  }

  .contact-map {
    min-height: 400px;
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-map {
      height: 400px;
    }
    .contact-info {
      padding: 2rem;
    }
  }
</style>
